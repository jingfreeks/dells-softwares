# Points at the SAME Supabase project as tindahan-pos and inventory-app.
#
# The anon key is the only key this app ever holds. Platform powers come
# from core.platform_admins plus a verified second factor -- never from a
# privileged key in the browser. NEVER put the service_role key here: it
# bypasses every RLS policy, and this app is precisely the one where that
# would be catastrophic.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
