# Copy this file to .env and fill in the SAME Supabase project's values used
# by apps/tindahan-pos (Project Settings → API in the Supabase dashboard).
# This app is a separate frontend but reads/writes the same database, so it
# must point at the same project.
#
# VITE_SUPABASE_ANON_KEY is safe to expose in the browser bundle — it only
# grants what the Row Level Security policies in tindahan-pos's
# supabase/migrations allow for the signed-in user. NEVER put the
# service_role key in this file or anywhere in the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
